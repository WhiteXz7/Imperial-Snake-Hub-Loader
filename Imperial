UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == ImperialSerpent.Config.Keybinds.ToggleUI then
        Window:Toggle()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Fly then
        ToggleFly()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Noclip then
        ToggleNoclip()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Panic then
        Window:Destroy()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.AutoClick then
        ToggleAutoClicker()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.InfiniteJump then
        ToggleInfiniteJump()
    end
end)

