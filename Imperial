-- ========== [ SISTEMA DE EXPANSÃO DINÂMICA ] ==========
local function AddNewMorph(name, morphData)
    ImperialSerpent.Assets.Morphs[name] = morphData

    -- Encontrar a categoria apropriada
    local category = "Custom"
    for cat, morphs in pairs(morphCategories) do
        for _, morphName in pairs(morphs) do
            if morphName == name then
                category = cat
                break
            end
        end
    end

    -- Adicionar à UI
    Tabs.Morphs:AddButton({
        Title = morphData.Name,
        Description = "Apply " .. morphData.Name .. " morph",
        Callback = function()
            ApplyMorph(morphData)
        end
    }, category)

    Fluent:Notify({
        Title = "New Morph Added!",
        Content = morphData.Name .. " has been added to the Morphs tab.",
        Duration = 3
    })
end

local function AddNewAnimation(name, animId)
    ImperialSerpent.Assets.Animations[name] = animId

    -- Encontrar a categoria apropriada
    local category = "Custom"
    for cat, skills in pairs(skillCategories) do
        for _, skillName in pairs(skills) do
            if skillName == name then
                category = cat
                break
            end
        end
    end

    -- Adicionar à UI
    Tabs.Combat:AddButton({
        Title = name,
        Description = "Play " .. name .. " animation",
        Callback = function()
            PlayAnimation(animId, 1, false)
        end
    }, category)

    Fluent:Notify({
        Title = "New Animation Added!",
        Content = name .. " has been added to the Combat tab.",
        Duration = 3
    })
end

